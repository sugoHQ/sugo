  "tests": {
    "_comment": "Each platform feature has its own tests on each platform: tst_platform_parity checks they are registered.",
    "Notifications": {
      "linux": [
        "tst_freedesktopnotifier",
        "tst_traynotifier",
        "tst_phasenotifier"
      ],
      "macos": [
        "tst_macnotificationmapping",
        "tst_traynotifier",
        "tst_phasenotifier"
      ]
    },
    "Silence notifications while working": {
      "linux": [
        "tst_freedesktopinhibitor",
        "tst_silence"
      ],
      "macos": [
        "tst_shortcutsfocusinhibitor",
        "tst_shortcutsfocusinstaller",
        "tst_silence"
      ]
    },
    "Keep the screen awake": {
      "linux": [
        "tst_powerinhibitor"
      ],
      "macos": [
        "tst_macpowerassertion"
      ]
    },
    "Pause when the screen locks": {
      "linux": [
        "tst_screenlockwatcher"
      ],
      "macos": [
        "tst_screenlockwatcher"
      ]
    },
    "Start at login": {
      "linux": [
        "tst_autostart"
      ],
      "macos": [
        "tst_launchagentautostart"
      ]
    },
    "Calendar password in the keyring": {
      "linux": [
        "tst_secretstore",
        "tst_calendarsync"
      ],
      "macos": [
        "tst_mackeychainstore",
        "tst_calendarsync"
      ]
    },
    "One instance at a time": {
      "linux": [
        "tst_singleinstance"
      ],
      "macos": [
        "tst_localsingleinstance"
      ]
    },
    "Control from other programs": {
      "linux": [
        "tst_dbustimerservice",
        "tst_krunnerservice"
      ],
      "macos": [
        "tst_timercommands"
      ]
    },
    "Tray / menu bar icon": {
      "linux": [
        "tst_traycontroller",
        "tst_traypresenter"
      ],
      "macos": [
        "tst_traycontroller",
        "tst_traypresenter",
        "tst_dockcontroller"
      ]
    },
    "Updates": {
      "linux": [
